<idea-plugin>
    <id>com.codexgui.jetbrains</id>
    <name>CodeDeck</name>
    <vendor>CodeDeck</vendor>

    <description><![CDATA[
      A native Codex / Claude Code CLI interface for JetBrains IDEs, with change lists,
      native diffs, and AI annotations. English and Simplified Chinese interfaces follow the IDE language.
      <br>
      面向 JetBrains IDE 的 Codex / Claude Code 图形界面。连接 Codex app-server 与
      Claude Code CLI，不注入第三方隐藏提示词。支持跟随 IDE 语言的简体中文与英文界面。
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.vcs</depends>
    <depends optional="true" config-file="changelist-perforce.xml">PerforceDirectPlugin</depends>
    <incompatible-with>dev.p4changelist.toolwindow</incompatible-with>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="CodeDeck Changes" anchor="left" secondary="false" order="last"
                    icon="/icons/changelist.svg" factoryClass="com.codexgui.changelist.ui.VcsToolWindowFactory"/>
        <projectConfigurable id="com.codexgui.changelist.settings" parentId="com.codexgui.settings"
                             displayName="ChangeList" instance="com.codexgui.changelist.settings.SidebarConfigurable"/>
        <toolWindow id="CodeDeck"
                    anchor="right"
                    icon="/icons/codex.svg"
                    factoryClass="com.codexgui.ui.CodexToolWindowFactory"
                    canCloseContents="false"/>
        <applicationConfigurable id="com.codexgui.settings"
                                 parentId="tools"
                                 displayName="CodeDeck"
                                 instance="com.codexgui.settings.CodexSettingsConfigurable"/>
        <applicationService serviceImplementation="com.codexgui.settings.CodexSettingsState"/>
        <projectService serviceImplementation="com.codexgui.service.CodexAppServerService"/>
        <projectService serviceImplementation="com.codexgui.service.ClaudeCodeService"/>
        <projectService serviceImplementation="com.codexgui.service.ClaudeHookRelayService"/>
        <projectService serviceImplementation="com.codexgui.service.ConversationChangeTracker"/>
        <projectService serviceImplementation="com.codexgui.settings.CodexProjectSettingsState"/>
        <notificationGroup id="CodeDeck Notifications"
                           displayType="BALLOON"
                           isLogByDefault="false"/>
    </extensions>
</idea-plugin>
